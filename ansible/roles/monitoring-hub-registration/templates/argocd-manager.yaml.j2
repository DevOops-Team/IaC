# 모니터링 클러스터 안의 Argo CD 계정 (GPU-177). 저장 층 차트가 CRD · ClusterRole · Webhook을 설치하므로 cluster-admin.
# 배포 범위는 관리 클러스터 Gitops의 AppProject가 제한한다.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: argocd-manager
  namespace: kube-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: argocd-manager
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
- kind: ServiceAccount
  name: argocd-manager
  namespace: kube-system
---
# 만료 없는 토큰 (ADR-9, EKS 등록과 같음)
apiVersion: v1
kind: Secret
metadata:
  name: argocd-manager-token
  namespace: kube-system
  annotations:
    kubernetes.io/service-account.name: argocd-manager
type: kubernetes.io/service-account-token
